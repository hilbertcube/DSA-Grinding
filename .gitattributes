# Normalize line endings on commit; check out with native endings
* text=auto

# Explicit text types
*.cpp   text diff=cpp
*.hpp   text diff=cpp
*.h     text diff=cpp linguist-language=C++
*.md    text diff=markdown
*.json  text
*.sh    text eol=lf
.clang-format text eol=lf

# Binary artifacts (never diff or normalize)
*.o     binary
*.a     binary
*.so    binary
*.out   binary
*.exe   binary

# Vendored code: exclude from language stats and diffs
third_party/** linguist-vendored
